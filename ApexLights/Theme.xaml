<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Settings-window resources. Native Fluent control templates come from Window.ThemeMode. -->
    <FontFamily x:Key="UiFont">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="UiMono">Cascadia Mono, Consolas</FontFamily>
    <Thickness x:Key="PageInset">24,16,24,20</Thickness>
    <Thickness x:Key="CardInset">16</Thickness>
    <CornerRadius x:Key="CardRadius">8</CornerRadius>
    <Style x:Key="SectionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource UiCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource UiStroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}"/>
        <Setter Property="Padding" Value="{StaticResource CardInset}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="SupportingText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource UiMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Margin" Value="0,4,0,4"/>
    </Style>
    <SolidColorBrush x:Key="BrandOrange" Color="#FF784A"/>
    <Style x:Key="NavigationItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource UiText}"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Surface" CornerRadius="4" Margin="0,2"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        <Border x:Name="Marker" Width="3" Height="16" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentButtonBackground}" Visibility="Hidden"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource UiCard}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource UiCard}"/>
                            <Setter TargetName="Marker" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- WPF provides ToggleButton semantics and UI Automation; only the switch visual is custom. -->
    <Style x:Key="SettingSwitch" TargetType="ToggleButton">
        <Setter Property="MinWidth" Value="84"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                        <Border Grid.Column="1" x:Name="Track" Height="20" CornerRadius="10" Background="{DynamicResource UiCard}" BorderBrush="{DynamicResource UiMuted}" BorderThickness="1">
                            <Ellipse x:Name="Thumb" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource UiMuted}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentButtonBackground}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentButtonBackground}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentButtonForeground}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Thumb" Property="Width" Value="14"/><Setter TargetName="Thumb" Property="Height" Value="14"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".55"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="TrackDark" Color="#171C21"/>
    <SolidColorBrush x:Key="TrackLight" Color="#CBD2D8"/>
</ResourceDictionary>
